# =====================================================
# BACKEND .env.example — Copy thành .env và điền giá trị
# Database: MySQL 8 (adapter db_mysql.ts — KHÔNG dùng SQLite)
# =====================================================
NODE_ENV=development
PORT=3500

# URL ứng dụng (backend dùng cho link đặt lại mật khẩu, link thông báo portal)
APP_BASE_URL=http://localhost:5173
VITE_API_URL=http://localhost:5173

# Khóa JWT — BẮT BUỘC thay bằng chuỗi ngẫu nhiên khi production
JWT_SECRET=change-me-to-a-random-32-char-string

# Danh sách origin được phép (CORS) — đặt domain thật trong production
ALLOWED_ORIGIN=http://localhost:5173

# ── MySQL 8 ──────────────────────────────────────────
# Cách 1 (khuyến nghị): dùng connection string
DATABASE_URL=mysql://tranle:change-me-to-a-strong-password@127.0.0.1:3306/tranletask

# Cách 2: dùng từng biến riêng (chỉ có tác dụng khi KHÔNG đặt DATABASE_URL)
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=tranle
MYSQL_PASSWORD=change-me-to-a-strong-password
MYSQL_DATABASE=tranletask

# Mật khẩu tạm cho tài khoản Admin khi seed DB lần đầu — bắt buộc đổi khi đăng nhập
ADMIN_DEFAULT_PASSWORD=change-this-before-seeding

# ── SMTP (gửi mail) ──────────────────────────────────
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_smtp_user
SMTP_PASS=your_smtp_password
SMTP_FROM="Tran Le Tasks <noreply@tranlecorp.com.vn>"

# ── IMAP (đồng bộ webmail) ──────────────────────────
IMAP_HOST=imap.example.com
IMAP_PORT=993

# Khóa mã hóa mật khẩu email lưu trong DB — cần đặt cố định (>= 16 ký tự) khi production.
# Nếu bỏ trống ở dev/test, server dùng key ngẫu nhiên theo phiên: dữ liệu đã mã hóa từ phiên trước sẽ không giải mã được sau khi restart.
MAIL_ENCRYPTION_KEY=change-me-to-at-least-16-characters