# =============================================
# BACKEND .env.example - Copy thành .env và điền giá trị
# =============================================
PORT=3500
DB_PATH=./database.sqlite
NODE_ENV=development

# JWT Secret (BẮT BUỘC Ở PRODUCTION)
JWT_SECRET=your-secret-key-here-change-this

# Mật khẩu mặc định cho Admin
# PRODUCTION: bắt buộc đặt mật khẩu mạnh ≥12 ký tự qua biến môi trường, KHÔNG commit giá trị thật.
# Ví dụ: ADMIN_DEFAULT_PASSWORD=<mat-khau-manh-ngau-nhien>
# Nếu không đặt: production từ chối seed, dev tự sinh mật khẩu ngẫu nhiên cho từng user.
