# ── Server & Runtime ─────────────────────────────────────────────────────────
NODE_ENV=production
PORT=3500

# ── Database (MySQL) ─────────────────────────────────────────────────────────
MYSQL_DATABASE=tranletask
MYSQL_USER=tranle
MYSQL_PASSWORD=change-me-to-a-strong-password
MYSQL_ROOT_PASSWORD=change-me-to-a-strong-root-password
MYSQL_PORT=3306
DATABASE_URL=mysql://tranle:change-me-to-a-strong-password@localhost:3306/tranletask

# ── Security Keys (BẮT BUỘC thay đổi khi triển khai) ──────────────────────────
# Không commit giá trị thật. Đặt qua biến môi trường / secret manager.
# JWT_SECRET: chuỗi ngẫu nhiên ≥32 ký tự (vd: openssl rand -hex 32)
# MAIL_ENCRYPTION_KEY: chuỗi ngẫu nhiên hoặc 64 ký tự hex (được dẫn xuất bằng scrypt + AES-256-GCM)
# ADMIN_DEFAULT_PASSWORD: mật khẩu mạnh ≥12 ký tự, chỉ dùng để seed admin đầu tiên
JWT_SECRET=
MAIL_ENCRYPTION_KEY=
ADMIN_DEFAULT_PASSWORD=

# Public base URL of this app (no trailing slash). REQUIRED in production:
# reset-password links are built from it. Example:
# APP_BASE_URL=https://task.tranlecorp.com.vn
APP_BASE_URL=

# Comma-separated allowed CORS origins. Example:
# ALLOWED_ORIGIN=https://task.tranlecorp.com.vn
ALLOWED_ORIGIN=

# ── Reverse proxy (đọc IP thật cho rate limit) ──────────────────────────────────
# X-Forwarded-For là dữ liệu do client kiểm soát. App chỉ tin nó khi request đến
# từ một proxy đã khai báo. Nếu không, ai cũng tự chọn được IP trong header và
# mọi rate limiter theo IP đều vô hiệu — khoá đăng nhập ngừng hoạt động.
#
#   TRUST_PROXY_CIDRS=172.16.0.0/12   danh sách IP/CIDR của proxy (ưu tiên)
#   TRUST_PROXY_HOPS=1                số lớp proxy (yếu hơn)
#   TRUST_PROXY=none                  không có proxy nào trước app
#
# ⚠ Mô hình docker-compose trong repo: Nginx chạy trên HOST, app trong CONTAINER.
#   Container nhìn thấy Nginx là IP gateway của network Docker (172.x), KHÔNG phải
#   127.0.0.1 — nên đừng đặt 127.0.0.1 ở đây. Giá trị mặc định bên dưới là dải
#   bridge của Docker; chỉ an toàn vì docker-compose.yml bind cổng app về
#   127.0.0.1, tức không ai ngoài host tới được container.
#   Xác nhận subnet thật trên máy production:
#     docker network inspect <project>_default --format '{{range .IPAM.Config}}{{.Subnet}}{{end}}'
#   Nếu proxy nằm ở máy khác (không phải host), KHÔNG bind loopback cổng app và
#   đặt CIDRS theo đúng dải IP của proxy.
#
# ⚠ KHÔNG đặt TRUST_PROXY=none khi production có proxy: giới hạn đăng nhập là 10
#   lần / 15 phút theo IP, nên khi đó mọi nhân viên dùng chung IP của proxy và 10
#   lần gõ sai sẽ khoá cả công ty.
#
# ⚠ Proxy phải GHI ĐÈ X-Forwarded-For bằng $remote_addr, không nên append:
#     proxy_set_header X-Forwarded-For $remote_addr;
#   Nếu nginx dùng `proxy_add_x_forwarded_for` (mặc định) thì giá trị client gửi
#   vẫn nằm trong header và client tự chọn lại được IP.
TRUST_PROXY_CIDRS=172.16.0.0/12

# ── SMTP Mail Configuration ──────────────────────────────────────────────────
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_smtp_user
SMTP_PASS=your_smtp_password
SMTP_FROM="Tran Le Tasks <noreply@tranlecorp.com.vn>"

# ── Frontend Build-time Variables ────────────────────────────────────────────
# NOTE: never put real AI keys in VITE_* vars — they bundle into public JS.
# All AI keys live server-side in system_config (encrypted).
