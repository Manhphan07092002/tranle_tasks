# ── Server & Runtime ─────────────────────────────────────────────────────────
NODE_ENV=production
PORT=3500

# ── Database (MySQL) ─────────────────────────────────────────────────────────
MYSQL_DATABASE=tranletask
MYSQL_USER=tranle
MYSQL_PASSWORD=change-me-to-a-strong-password
MYSQL_ROOT_PASSWORD=change-me-to-a-strong-root-password
MYSQL_PORT=3306
DATABASE_URL=mysql://tranle:change-me-to-a-strong-password@localhost:3306/tranletask

# ── Security Keys (BẮT BUỘC thay đổi khi triển khai) ──────────────────────────
JWT_SECRET=change-me-to-a-random-32-char-string
MAIL_ENCRYPTION_KEY=change-me-to-exactly-32-bytes!!
ADMIN_DEFAULT_PASSWORD=TranLe@dmin2026!

# ── SMTP Mail Configuration ──────────────────────────────────────────────────
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_smtp_user
SMTP_PASS=your_smtp_password
SMTP_FROM="Tran Le Tasks <noreply@tranlecorp.com.vn>"

# ── Frontend Build-time Variables ────────────────────────────────────────────
VITE_GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE
