# ── Server & Runtime ─────────────────────────────────────────
NODE_ENV=production
PORT=3500

# URL ứng dụng (link đặt lại mật khẩu, link thông báo)
APP_BASE_URL=https://task.tranlecorp.com.vn
ALLOWED_ORIGIN=https://task.tranlecorp.com.vn

# ── Database (MySQL 8) ─────────────────────────────────────────
MYSQL_DATABASE=tranletask
MYSQL_USER=tranle
MYSQL_PASSWORD=change-me-to-a-strong-password
MYSQL_ROOT_PASSWORD=change-me-to-a-strong-root-password
MYSQL_PORT=3306
# Trong Docker, host là tên service "mysql" của docker-compose
DATABASE_URL=mysql://tranle:change-me-to-a-strong-password@mysql:3306/tranletask

# ── Security Keys (BẮT BUỘC thay đổi khi triển khai) ──────────
JWT_SECRET=change-me-to-a-random-32-char-string
MAIL_ENCRYPTION_KEY=change-me-to-at-least-16-characters
# Mật khẩu tạm cho tài khoản Admin khi seed DB — bắt buộc đổi khi đăng nhập
ADMIN_DEFAULT_PASSWORD=change-this-before-seeding

# ── SMTP Mail Configuration ──────────────────────────────────
SMTP_HOST=smtp.tranlecorp.com.vn
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_smtp_user
SMTP_PASS=your_smtp_password
SMTP_FROM="Tran Le Tasks <noreply@tranlecorp.com.vn>"

# ── IMAP Mail Configuration ──────────────────────────────────
IMAP_HOST=imap.tranlecorp.com.vn
IMAP_PORT=993